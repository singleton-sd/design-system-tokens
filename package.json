{
  "name": "@singleton-sd/tokens",
  "version": "1.2.0",
  "description": "Singleton SD's cross-platform design tokens for consistent UI spacing, typography, and theming. Distributed as an npm package and raw JSON for design tools and applications.",
  "style": "dist/css/light/_variables.css",
  "exports": {
    "./css/light": "./dist/css/light/_variables.css",
    "./css/dark": "./dist/css/dark/_variables.css",
    "./css/root/light": "./dist/css/root/light/_variables.css",
    "./css/root/dark": "./dist/css/root/dark/_variables.css",
    "./scss/light": "./dist/scss/light/_variables.scss",
    "./scss/dark": "./dist/scss/dark/_variables.scss",
    "./tailwind": "./dist/tailwind/tailwind.config.js"
  },
  "scripts": {
    "build-all": "yarn build",
    "build": "yarn build-dark && yarn build-light && yarn build-tailwind",
    "build-dark": "style-dictionary build -c style-dictionary.config.dark.mjs --verbose",
    "build-light": "style-dictionary build -c style-dictionary.config.light.mjs --verbose",
    "build-tailwind": "style-dictionary build -c style-dictionary.config.tailwind.mjs --verbose",
    "flatten-typography": "node scripts/flattenTypography.mjs",
    "split-tokens": "node scripts/split-tokens.mjs && yarn flatten-typography",
    "dev": "yarn split-tokens && yarn build",
    "release": "env-cmd -x release-it -VV --dry-run",
    "release:ci": "release-it --ci"
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@release-it/conventional-changelog": "^10.0.0",
    "@types/node": "^20.19.0",
    "husky": "^9.1.7",
    "release-it": "^18.1.2",
    "sd-tailwindcss-transformer": "^2.1.0",
    "style-dictionary": "^5.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.2"
  },
  "author": "Patricio Perpetua",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://gitlab.com/singleton-sd/design-system/tokens.git"
  },
  "keywords": [
    "singletonsd",
    "singleton-sd",
    "patricioperpetua",
    "figma",
    "figma-tokens",
    "design-tokens"
  ],
  "engines": {
    "node": "22.x"
  }
}
