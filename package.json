{
  "name": "@singleton-sd/tokens",
  "version": "1.8.0",
  "description": "Singleton SD's cross-platform design tokens for consistent UI spacing, typography, and theming. Distributed as an npm package and raw JSON for design tools and applications.",
  "style": "dist/css/light.css",
  "exports": {
    "./css/light": "./dist/css/light.css",
    "./css/dark": "./dist/css/dark.css",
    "./css/root/light": "./dist/css/root/light/_variables.css",
    "./css/root/dark": "./dist/css/root/dark/_variables.css",
    "./scss": "./dist/scss/_tokens.scss",
    "./scss/light": "./dist/scss/light/_variables.scss",
    "./scss/dark": "./dist/scss/dark/_variables.scss",
    "./css-vars": {
      "types": "./dist/css-vars/index.d.mts",
      "import": "./dist/css-vars/index.mjs",
      "default": "./dist/css-vars/index.mjs"
    },
    "./tailwind": "./dist/tailwind/theme.js",
    "./js": {
      "types": "./dist/js/tokens.d.mts",
      "import": "./dist/js/tokens.mjs",
      "default": "./dist/js/tokens.mjs"
    },
    "./tokens.json": "./dist/tokens.json"
  },
  "scripts": {
    "build-all": "yarn build",
    "build": "node scripts/build.mjs",
    "test": "node --test scripts/*.test.mjs",
    "validate:css": "node scripts/validate-css-output.mjs",
    "dev": "yarn build",
    "release": "env-cmd -x release-it -VV --dry-run",
    "release:ci": "release-it --ci"
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@release-it/conventional-changelog": "^10.0.0",
    "@types/node": "^20.19.0",
    "husky": "^9.1.7",
    "release-it": "^18.1.2",
    "sd-tailwindcss-transformer": "^2.1.0",
    "style-dictionary": "^5.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.2"
  },
  "author": "Patricio Perpetua",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://gitlab.com/singleton-sd/design-system/tokens.git"
  },
  "keywords": [
    "singletonsd",
    "singleton-sd",
    "patricioperpetua",
    "patoperpetua",
    "penpot",
    "design-tokens",
    "dtcg"
  ],
  "engines": {
    "node": "22.x"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
