{
  "color": {
    "text": {
      "default": { "$value": "{color.yellow-light.500}", "$type": "color" },
      "muted": { "$value": "{color.yellow-dark.500}", "$type": "color" },
      "subtle": { "$value": "{color.yellow-dark.300}", "$type": "color" },
      "disabled": { "$value": "{color.gray.400}", "$type": "color" },
      "inverse": { "$value": "{color.white}", "$type": "color" },
      "brand": { "$value": "{color.yellow-light.500}", "$type": "color" },
      "on-brand": { "$value": "{color.gray.900}", "$type": "color" },
      "link": { "$value": "{color.yellow-light.600}", "$type": "color" }
    },
    "background": {
      "default": { "$value": "{color.white}", "$type": "color" },
      "muted": { "$value": "{color.gray.100}", "$type": "color" },
      "subtle": { "$value": "{color.gray.200}", "$type": "color" },
      "inverse": { "$value": "{color.black}", "$type": "color" },
      "brand": { "$value": "{color.yellow-light.500}", "$type": "color" },
      "brand-hovered": { "$value": "{color.yellow-light.600}", "$type": "color" }
    },
    "border": {
      "default": { "$value": "{color.gray.300}", "$type": "color" },
      "muted": { "$value": "{color.gray.200}", "$type": "color" },
      "strong": { "$value": "{color.gray.500}", "$type": "color" },
      "focus": { "$value": "{color.yellow-light.500}", "$type": "color" },
      "brand": { "$value": "{color.yellow-light.500}", "$type": "color" }
    },
    "icon": {
      "default": { "$value": "{color.text.default}", "$type": "color" },
      "muted": { "$value": "{color.text.muted}", "$type": "color" },
      "inverse": { "$value": "{color.text.inverse}", "$type": "color" },
      "brand": { "$value": "{color.text.brand}", "$type": "color" }
    },
    "feedback": {
      "danger": {
        "text": { "$value": "{color.red.700}", "$type": "color" },
        "background": { "$value": "{color.red.100}", "$type": "color" },
        "border": { "$value": "{color.red.400}", "$type": "color" }
      },
      "warning": {
        "text": { "$value": "{color.orange.700}", "$type": "color" },
        "background": { "$value": "{color.orange.100}", "$type": "color" },
        "border": { "$value": "{color.orange.400}", "$type": "color" }
      },
      "success": {
        "text": { "$value": "{color.green.700}", "$type": "color" },
        "background": { "$value": "{color.green.100}", "$type": "color" },
        "border": { "$value": "{color.green.400}", "$type": "color" }
      },
      "info": {
        "text": { "$value": "{color.blue.700}", "$type": "color" },
        "background": { "$value": "{color.blue.100}", "$type": "color" },
        "border": { "$value": "{color.blue.400}", "$type": "color" }
      }
    }
  },
  "shadow": {
    "sm": {
      "$type": "shadow",
      "$value": {
        "offsetX": "0px",
        "offsetY": "1px",
        "blur": "2px",
        "spread": "0px",
        "color": "{color.gray.900}",
        "type": "dropShadow"
      }
    },
    "md": {
      "$type": "shadow",
      "$value": {
        "offsetX": "0px",
        "offsetY": "4px",
        "blur": "8px",
        "spread": "0px",
        "color": "{color.gray.900}",
        "type": "dropShadow"
      }
    },
    "lg": {
      "$type": "shadow",
      "$value": {
        "offsetX": "0px",
        "offsetY": "12px",
        "blur": "24px",
        "spread": "0px",
        "color": "{color.gray.900}",
        "type": "dropShadow"
      }
    }
  },
  "typography": {
    "display": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.heading}",
        "fontWeight": "{font.weight.bold}",
        "fontSize": "72px",
        "lineHeight": "{lineHeight.heading}",
        "letterSpacing": "{letterSpacing.heading}"
      }
    },
    "h1": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.heading}",
        "fontWeight": "{font.weight.bold}",
        "fontSize": "64px",
        "lineHeight": "{lineHeight.heading}",
        "letterSpacing": "{letterSpacing.heading}"
      }
    },
    "h2": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.heading}",
        "fontWeight": "{font.weight.bold}",
        "fontSize": "{font.size.700}",
        "lineHeight": "{lineHeight.heading}",
        "letterSpacing": "{letterSpacing.heading}"
      }
    },
    "h3": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.heading}",
        "fontWeight": "{font.weight.semibold}",
        "fontSize": "{font.size.600}",
        "lineHeight": "{lineHeight.heading}",
        "letterSpacing": "{letterSpacing.heading}"
      }
    },
    "body": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.body}",
        "fontWeight": "{font.weight.regular}",
        "fontSize": "{font.size.300}",
        "lineHeight": "{lineHeight.body}",
        "letterSpacing": "{letterSpacing.default}"
      }
    },
    "body-sm": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.body}",
        "fontWeight": "{font.weight.regular}",
        "fontSize": "{font.size.200}",
        "lineHeight": "{lineHeight.body}",
        "letterSpacing": "{letterSpacing.default}"
      }
    },
    "caption": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.body}",
        "fontWeight": "{font.weight.medium}",
        "fontSize": "{font.size.100}",
        "lineHeight": "{lineHeight.body}",
        "letterSpacing": "{letterSpacing.default}"
      }
    },
    "legal": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.body}",
        "fontWeight": "{font.weight.regular}",
        "fontSize": "{font.size.100}",
        "lineHeight": "{lineHeight.body}",
        "letterSpacing": "{letterSpacing.default}"
      }
    }
  }
}
