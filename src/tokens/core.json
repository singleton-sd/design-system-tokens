  "fontSizes": {
    "base": {
      "$type": "fontSizes",
      "$value": "16px"
    },
    "heading6": {
      "$type": "fontSizes",
      "$value": "{fontSizes.base} * 1.625"
    },
    "heading5": {
      "$type": "fontSizes",
      "$value": "{fontSizes.base} * 2.25"
    },
