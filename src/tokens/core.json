    "sm": {
      "$type": "spacing",
      "$value": "{fontSizes.base} * 0.5"
    },
    "md": {
      "$type": "spacing",
      "$value": "{fontSizes.base}"
    },
    "lg": {
      "$type": "spacing",
      "$value": "{fontSizes.base} * 2"
    },
    "xl": {
      "$type": "spacing",
      "$value": "{fontSizes.base} * 4"
    },
    "xxl": {
      "$type": "spacing",
      "$value": "{fontSizes.base} * 4.5"
    }
  },
  "fontFamilies": {
    "heading": {
